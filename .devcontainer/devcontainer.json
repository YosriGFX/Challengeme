{
  // A Debian box for OP Console. Node (for npm and wrangler) is added on top; the prebuilt
  // .wasm files are in the repo, so `node host/sim.mjs` and `npx wrangler dev` work without
  // a C toolchain. (To also rebuild the .wasm with `make`, add clang + lld: see below.)
  "name": "OP Console",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  // Install the Worker's dependencies. esbuild and workerd run their install scripts here to
  // fetch their native binaries (they are the only deps in this tree with scripts that do
  // anything), so a plain install allows exactly those.
  "postCreateCommand": "cd worker && npm install",

  // `npx wrangler dev` / `node host/sim.mjs` listen on 8787; open the forwarded URL on a phone.
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": { "label": "OP Console", "onAutoForward": "notify" }
  }

  // Want to rebuild the cartridges too? Uncomment:
  // ,"onCreateCommand": "sudo apt-get update && sudo apt-get install -y clang lld"
}
