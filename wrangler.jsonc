{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "challengeme",
	"main": "src/index.js",
	"compatibility_date": "2026-10-22",
	"compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	"assets": {
		"directory": "./public",
		"not_found_handling": "404-page",
		"run_worker_first": ["/ws/*", "/api/*"]
	},
	"durable_objects": { "bindings": [{ "name": "MATCH", "class_name": "Match" }] },
	"exports": { "Match": { "type": "durable-object", "storage": "sqlite" } },
	// Local testing with phones on the same network: wrangler dev listens on every address
	// of this machine, so phones reach it at http://192.168.64.10:8787 (LAN) or
	// http://172.20.10.3:8787 (phone hotspot). Add any new address to APP_ORIGIN below.
	"dev": { "ip": "0.0.0.0", "port": 8787 },
	// Page origins allowed to open match sockets, comma separated, besides pages served by
	// the same host (any scheme, so https through a TLS proxy works too). For production,
	// set the deployed origin (e.g. "https://challengeme.<account>.workers.dev").
	"vars": { "APP_ORIGIN": "http://192.168.64.10:8787,https://192.168.64.10:8787,http://172.20.10.3:8787,https://172.20.10.3:8787,http://localhost:8787" }
}
