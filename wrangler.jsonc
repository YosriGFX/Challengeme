{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "challengeme",
	"main": "src/index.js",
	"compatibility_date": "2026-10-22",
	"compatibility_flags": ["no_nodejs_compat", "no_nodejs_compat_v2"],
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	"assets": {
		"directory": "./public",
		"not_found_handling": "404-page",
		"run_worker_first": ["/ws/*"]
	},
	"durable_objects": { "bindings": [{ "name": "MATCH", "class_name": "Match" }] },
	"exports": { "Match": { "type": "durable-object", "storage": "sqlite" } },
	// Local testing with phones on the same network: wrangler dev listens on this address.
	"dev": { "ip": "192.168.64.10", "port": 8787 },
	// Page origins allowed to open match sockets, comma separated. For production, set the
	// deployed origin (e.g. "https://challengeme.<account>.workers.dev").
	"vars": { "APP_ORIGIN": "http://192.168.64.10:8787,https://192.168.64.10:8787,http://localhost:8787" }
}
